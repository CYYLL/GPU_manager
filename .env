# ═══════════════════════════════════════════
# GPU Resource Manager - Environment Config
# ═══════════════════════════════════════════
# Copy this file to .env and adjust values.
# Restart the backend after changes.

# ── Security ──
SECRET_KEY=080e49fb15d792bda9c089aa8f18e634faef8645bd691d983de757e15fa01648
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1

# ── Container mount root ──
# Parent directory for gpu-{username}/ mounts inside containers.
CONTAINER_MOUNT_ROOT=/amax

# ── GPU allocation ──
# Lock timeout in seconds for GPU allocation requests.
ALLOCATION_TIMEOUT=60

# ── Container SSH port range ──
PORT_RANGE_START=22000
PORT_RANGE_END=22999

# ── GPU stale detection ──
# Memory utilization % below this threshold is considered idle.
STALE_MEMORY_THRESHOLD=5

# ── Database (default: SQLite at backend/ directory) ──
# For PostgreSQL, use:
# DATABASE_URL=postgresql://user:password@host:5432/gpu_manager
# DATABASE_URL=sqlite:///./gpu_resource_manager.db
