[Unit]
Description=GPU Resource Manager Backend
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=amax
WorkingDirectory=/amax/gpu_manager/backend
Environment="SECRET_KEY=you-need-to-change-this-in-production"
Environment="CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1"
ExecStart=/home/amax/.local/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
