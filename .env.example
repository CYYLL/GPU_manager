# ═══════════════════════════════════════════
# GPU Resource Manager - Environment Template
# ═══════════════════════════════════════════
# 复制为 .env 并按环境调整：  cp .env.example .env
# 配置在 backend/app/main.py import 阶段读取（load_dotenv(PROJECT_ROOT/.env)），
# 模块级构造（LLMClient / DockerRunner / 监控线程）在 import 时已冻结，
# 修改 .env 后必须重启后端才生效。
# 所有带默认值的项都可省略；列出的默认值 = 代码内置兜底。

# ── Security ────────────────────────────────
# 生产必须更换：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (comma-separated origins) ─────────
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1

# ── Container mount root ────────────────────
# Parent directory for gpu-{username}/ mounts inside containers. 必须绝对路径。
CONTAINER_MOUNT_ROOT=/amax

# ── GPU allocation ──────────────────────────
# Lock timeout in seconds for GPU allocation requests.
ALLOCATION_TIMEOUT=60

# ── Container SSH port range ────────────────
PORT_RANGE_START=22000
PORT_RANGE_END=22999

# ── GPU stale detection ─────────────────────
# Memory utilization % below this threshold is considered idle.
STALE_MEMORY_THRESHOLD=5

# ── Docker stop retry ───────────────────────
# stop/remove 总尝试次数（含首次）
DOCKER_STOP_ATTEMPTS=3
# 单次 stop 超时（秒）
DOCKER_STOP_TIMEOUT=10
# 重试间隔基数（秒），第 n 次间隔 = 基数 × n
DOCKER_STOP_RETRY_DELAY=2

# ── Database (default: SQLite at backend/) ──
# 留空/注释即用 SQLite。PostgreSQL 示例：
# DATABASE_URL=postgresql://user:password@host:5432/gpu_manager
# DATABASE_URL=sqlite:///./gpu_resource_manager.db

# ═══════════════════════════════════════════
# v2 - 双模式 / Agent
# ═══════════════════════════════════════════

# 新注册用户的默认模式：llm | traditional
MODE_DEFAULT=llm

# ── LLM / Agent ─────────────────────────────
# 选择 LLM 提供方：anthropic（默认，读下方 LLM_*/ANTHROPIC_*）| openai（读下方 OPENAI_*）。
# 两套 provider 配置可在 .env 共存，切换只改这一行；未知值后端启动即报错（fail-fast）。
LLM_PROVIDER=anthropic
# LLM_* 优先级高于 ANTHROPIC_*。
# API Key（未配置时 llm 用户调用 Agent 会失败）：
LLM_API_KEY=

# LLM Base URL —— 自定义网关/代理（OpenAI 兼容转发、国内中转等）。
# 优先级高于 ANTHROPIC_BASE_URL。留空 → 走 Anthropic 官方 https://api.anthropic.com。
# 例：LLM_BASE_URL=https://gateway.example.com/api
LLM_BASE_URL=

# 模型名 —— 选择模型的参数（LLM_MODEL > ANTHROPIC_DEFAULT_SONNET_MODEL > 内置 claude-sonnet-4-6）。
# 值需匹配你的 key/网关支持的模型名：
#   - 火山方舟 Coding Plan：ark-code-latest（跟随控制台+Auto）/ doubao-seed-2.0-code / kimi-k2.5 等
#   - Anthropic 官方 key：claude-sonnet-4-6 / claude-sonnet-5 等
LLM_MODEL=ark-code-latest
# LLM_STREAMING: auto|true 走原生流式；false 关流式（一次性 complete）
LLM_STREAMING=auto

# ── Anthropic 原生变量（被上方 LLM_* 覆盖，二选一即可）──
# 地址默认官方 https://api.anthropic.com；AUTH_TOKEN 即官方 API Key。
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6

# ── OpenAI（LLM_PROVIDER=openai 时生效，不读上方 LLM_*/ANTHROPIC_*）──
# API Key —— 必填（官方 key 或兼容网关 key，如火山方舟 /api/v3、vLLM）。
OPENAI_API_KEY=
# Base URL —— 可选；默认官方 https://api.openai.com/v1；兼容端点填这里（含协议与版本路径）。
OPENAI_BASE_URL=
# 模型名 —— 必填（无内置默认，防止误扣费）。值需匹配你的 key/网关，如 gpt-4o-mini。
OPENAI_MODEL=
# OPENAI_STREAMING: auto|true 走原生流式；false 关流式（一次性 complete）。语义同 LLM_STREAMING。
OPENAI_STREAMING=auto

# ── Monitor & retention ─────────────────────
# 监控/清理线程采样间隔（秒）。生产按需调小（如 300）以更快发现外部停止/水位。
MONITOR_INTERVAL=3600
# ContainerEvent 保留天数
EVENT_RETENTION_DAYS=30
# DiskSnapshot 保留天数
SNAPSHOT_RETENTION_DAYS=7
# 每用户保留的最近 chat 消息条数
CHAT_HISTORY_LIMIT=200

# ── Cleanup engine ──────────────────────────
# 总开关（0/false/no 关）
CLEANUP_ENABLED=true
# 预演模式：只记录决策、不实际删容器不回收空间
CLEANUP_DRY_RUN=false
# 磁盘水位（%）触发清理
DISK_THRESHOLD=85
# 临界水位（%）；达到时更激进
DISK_CRITICAL=95
# 常规清理目标水位（%）
DISK_TARGET=80
# 临界时目标水位（%）
DISK_CRITICAL_TARGET=90
# 两轮清理最小间隔（分钟）
CLEANUP_COOLDOWN_MINUTES=5
# 每 24h（UTC 0 点起）最多删容器数
CLEANUP_MAX_PER_DAY=10
# 每轮最多删容器数
CLEANUP_MAX_PER_ROUND=3
# 容器（SizeRw/运行 SizeRootFs）+ 可回收镜像 ≥ 此 GB 才触发 docker 侧清理
CONTAINER_RECLAIM_TRIGGER_GB=20
# BuildKit 缓存 ≥ 此 GB 时独立执行 builder prune
BUILD_CACHE_TRIGGER_GB=100
# 最小有效净释放；低于则升级容量告警
MIN_EFFECTIVE_FREE_GB=5
# /amax 下 gpu-* 工作区占全盘比例超过此值 → 建议扩容告警
WORKSPACE_DOMINANT_PCT=60
# 停止的容器空闲超过此天数才入候选
GRACE_DAYS=2
# 跨进程清理互斥锁文件（fcntl.flock），避免多实例并发清理
CLEANUP_LOCK_FILE=/tmp/gpu_manager_v2_cleanup.lock

# ── Frontend (build-time, optional) ─────────
# 仅前端构建时读取（frontend/src/services/*.js），不属于后端 .env 加载。
# 留空 = 同源（由 nginx 反代 /api）；独立部署前端时才需指定。
# REACT_APP_API_URL=
